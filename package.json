{
  "name": "graveshift",
  "version": "0.1.0",
  "private": true,
  "description": "Graveshift: round-based zombie survival and team deathmatch in the browser. All art CC0, sound made in code, original maps.",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "start": "node .tools/serve.mjs 5173",
    "bake": "node .tools/bake-map.mjs cinema",
    "test": "node --test",
    "test:routes": "node .tools/test-routes.mjs",
    "test:weapons": "node .tools/test-weapons.mjs",
    "test:mobile": "node .tools/test-mobile.mjs",
    "test:waves": "node .tools/test-waves.mjs 10",
    "check:licences": "python -I tools/check_manifest.py",
    "check:marks": "python -I tools/check_marks.py export/web"
  },
  "dependencies": {
    "three": "0.185.1",
    "three-mesh-bvh": "0.9.14",
    "@recast-navigation/core": "0.43.1",
    "@recast-navigation/generators": "0.43.1"
  },
  "devDependencies": { "playwright-core": "1.62.1" }
}
