{
  "name": "graveshift",
  "version": "0.1.0",
  "private": true,
  "description": "Graveshift: round-based zombie survival and team deathmatch in the browser. All art CC0, sound made in code, original maps.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node .tools/serve.mjs 5173",
    "bake": "node .tools/bake-map.mjs cinema",
    "test": "node --test",
    "test:routes": "node .tools/test-routes.mjs",
    "test:weapons": "node .tools/test-weapons.mjs",
    "test:mobile": "node .tools/test-mobile.mjs",
    "test:waves": "node .tools/test-waves.mjs 10",
    "test:tdm": "node .tools/test-tdm.mjs",
    "test:recovery": "node .tools/test-tdm.mjs 6 regular recovery",
    "test:holdout": "node .tools/test-tdm.mjs 6 regular holdout",
    "test:holdout-yard": "node .tools/test-tdm.mjs 6 regular holdout yard",
    "test:yard": "node .tools/test-tdm.mjs 6 regular tdm yard",
    "test:wharf": "node .tools/test-tdm.mjs 6 regular tdm wharf",
    "bake:wharf": "node .tools/bake-map.mjs wharf",
    "bake:yard": "node .tools/bake-map.mjs yard",
    "test:p2p": "node .tools/test-p2p.mjs",
    "test:lobby": "node .tools/test-lobby.mjs",
    "test:progress": "node .tools/test-progress.mjs",
    "bake:suburb": "node .tools/bake-map.mjs suburb",
    "check:licences": "python -I tools/check_manifest.py",
    "check:marks": "python -I tools/check_marks.py export/web worker",
    "test:api": "node .tools/test-api.mjs",
    "test:backend": "node .tools/test-backend.mjs",
    "test:coop": "node .tools/test-coop.mjs"
  },
  "dependencies": {
    "@recast-navigation/core": "0.43.1",
    "@recast-navigation/generators": "0.43.1",
    "three": "0.185.1",
    "three-mesh-bvh": "0.9.14"
  },
  "devDependencies": {
    "playwright-core": "1.62.1",
    "wrangler": "^4.149.0"
  }
}
